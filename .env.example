# Verity passkey demo configuration
# Set these in Netlify Site configuration > Environment variables.
# WEBAUTHN_ORIGIN must be the exact HTTPS site origin (no trailing slash).
WEBAUTHN_ORIGIN=https://your-site-name.netlify.app
# Must exactly match the hostname in WEBAUTHN_ORIGIN.
WEBAUTHN_RP_ID=your-site-name.netlify.app
# Generate a unique random secret of at least 32 characters; keep it private.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
